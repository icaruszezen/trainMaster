# trainMaster 部署配置。复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env。所有变量都有默认值，可以只写需要修改的项。

# ---- 访问 ----
# 宿主机上对外提供服务的 HTTP 端口，浏览器访问 http://<服务器IP>:<端口>
TM_HTTP_PORT=8080

# ---- 数据持久化（宿主机目录，绑定挂载）----
# 默认放在仓库目录下的 ./data，方便试用。正式部署建议改为仓库之外的绝对路径
# （如 /srv/trainmaster/storage、/srv/trainmaster/postgres）：在仓库里执行
# `git clean -x` 等清理命令会把 ./data 一起删除。
# 图片、数据集、模型权重、训练产物等文件数据目录，挂载为容器内 /data
TM_HOST_STORAGE_DIR=./data/storage
# PostgreSQL 数据目录（Windows 上不要放在 NTFS 盘符路径，见 docs/deployment.md）
TM_HOST_POSTGRES_DIR=./data/postgres

# ---- 数据库 ----
# 首次启动时用这些值初始化 PostgreSQL。初始化之后再修改密码，
# 需要先在数据库里执行 ALTER USER 修改，再同步修改这里。
TM_DB_USER=trainmaster
# 生产环境务必修改为强密码
TM_DB_PASSWORD=trainmaster
TM_DB_NAME=trainmaster

# ---- 运行用户 ----
# 应用以该 UID/GID 运行并写入存储目录。设为宿主机上存储目录属主的 UID/GID
# （执行 `id` 查看），这样在宿主机上可以直接读写图片文件。
PUID=1000
PGID=1000

# 时区（日志时间等）
TZ=Asia/Shanghai

# 日志级别：debug / info / warn / error
TM_LOG_LEVEL=info

# 前面有反向代理（nginx 等）时，填写代理的 IP 或网段（逗号分隔），访问日志才会采用
# 它转发的 X-Forwarded-For 作为客户端 IP；留空则不信任该请求头。见 docs/deployment.md。
TM_TRUSTED_PROXIES=

# ---- 镜像构建 ----
# 构建出的应用镜像标签：trainmaster:<TM_IMAGE_TAG>
TM_IMAGE_TAG=latest
# npm 源，国内可用 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
# Go 模块代理，国内可用 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct
# Alpine 软件源（运行镜像安装 tzdata 等），留空使用官方源，国内可用 https://mirrors.aliyun.com/alpine
ALPINE_MIRROR=
# 基础镜像，默认从 Docker Hub 拉取（node:22-alpine、golang:1.24-alpine、alpine:3.23、
# postgres:17-alpine）。无法访问 Docker Hub 时换成内网镜像仓库中的同名镜像：
# NODE_IMAGE=registry.example.com/library/node:22-alpine
# GO_IMAGE=registry.example.com/library/golang:1.24-alpine
# RUNTIME_IMAGE=registry.example.com/library/alpine:3.23
# POSTGRES_IMAGE=registry.example.com/library/postgres:17-alpine

# ---- 计算节点（训练节点）----
# make setup（make up 会先执行它）检测本机的 NVIDIA 显卡、驱动与 Docker 的 GPU 支持，
# 自动填写下面标有“make setup 写入”的变量。见 docs/deployment.md 第 10 节。
# 训练节点模式：auto（显卡、驱动与 Docker 的 GPU 支持都正常时用 GPU，否则用 CPU）、
# gpu / cpu（强制）、off（不运行训练节点）。也传给训练节点与 app：为 cpu 时页面不再提示显卡没有传入容器，
# 为 off 时不再提示没有 GPU 训练节点（app 启动时读取：修改后用 make up，如 make up SETUP_ARGS="--mode off"）
TM_TRAINER_MODE=auto
# 固定 PyTorch 变体（cu130 / cu126 / cu128 / cu118），不再按驱动与显卡自动选择；auto 为自动选择。
# 可用 make setup SETUP_ARGS="--variant cu126" 写入。CPU 训练节点请用 TM_TRAINER_MODE=cpu。
# 也传给训练节点：固定时页面上的修复建议用 --variant auto 恢复自动选择
TM_TRAINER_VARIANT=auto
# 启用的 compose profile（make setup 写入）：gpu → trainer 服务（GPU），cpu → trainer-cpu 服务（CPU）；
# 两者都没有时只运行 postgres 与 app。可以加入自己的其它 profile（逗号分隔），make setup 会保留它们
COMPOSE_PROFILES=
# 训练节点镜像中的 PyTorch 变体（make setup 按驱动与显卡选择）：cu130 / cu126 / cu128 / cu118 / cpu。
# 每次 make setup / make up 都会重新写入，手动修改会被覆盖；指定变体请用上面的 TM_TRAINER_VARIANT
TM_TORCH_VARIANT=
# 训练节点在平台上显示的名称（为空时 make setup 写入本机主机名；仍是它写入的主机名时跟随本机主机名的变化，
# 如把 .env 迁移到新服务器后；自己设置的名称不变）
TM_NODE_NAME=
# 本机的主机名（make setup 每次写入）：app 与训练节点容器以它作为主机名，页面上显示真实的机器名，
# 重建容器后也不变；留空时 app 为 trainmaster、训练节点为 trainmaster-trainer（主机名与服务名 app、postgres 相同时 make setup 留空）
TM_HOST_HOSTNAME=
# 节点令牌（make setup 生成）：平台只接受携带它的训练节点注册。其它机器上的训练节点填写同一个值
TM_NODE_TOKEN=
# 平台地址：只在其它机器上运行训练节点时设置（同一台机器上默认为 http://app:8080）
# TM_SERVER_URL=http://192.168.1.10:8080
# 训练节点的状态目录（节点标识 node-key 等），挂载为 trainer 容器内 /var/lib/trainmaster。
# 不要拷贝到其它机器（克隆虚拟机同理）：两台机器会成为同一个节点
TM_HOST_TRAINER_DIR=./data/trainer
# 训练节点的 /dev/shm 大小（PyTorch DataLoader 多进程加载数据使用），内存较小时可以调低
TM_TRAINER_SHM_SIZE=8gb
# 训练节点上单次模型转换（pt → ONNX，含校验）的时间上限：秒数，或带 s / m 后缀（如 900、30m），
# 不超过 24 小时；留空为 15 分钟。大模型在较慢的 CPU 上转换超时时调大
# TM_EXPORT_TIMEOUT=30m
# 平台判断节点离线的心跳间隔（离线 = 3 × 间隔 + 5 秒），留空为 10s
# TM_NODE_HEARTBEAT_INTERVAL=10s

# ---- 训练节点镜像构建 ----
# 基础镜像，无法访问 Docker Hub 时换成内网镜像仓库中的同名镜像（make setup 也用它验证 Docker 能否使用显卡）
# TRAINER_PYTHON_IMAGE=registry.example.com/library/python:3.12-slim-bookworm
# Debian 软件源，留空使用官方源，国内可用 https://mirrors.aliyun.com/debian
DEBIAN_MIRROR=
# PyPI 源（ultralytics 等依赖，以及 cu130 版 PyTorch），国内可用 https://mirrors.aliyun.com/pypi/simple
# 或 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple
# PyTorch 官方索引（cu126 / cu128 / cu118 / cpu 变体），留空为 https://download.pytorch.org/whl，
# 可换成提供同样目录结构的内网镜像（会自动拼接 /<变体>）
TORCH_INDEX_URL=
# 扁平目录形式的 PyTorch 镜像（设置后代替 TORCH_INDEX_URL，自动拼接 /<变体>/），国内可用 https://mirrors.aliyun.com/pytorch-wheels
TORCH_FIND_LINKS=
# NVIDIA Container Toolkit 软件源（make setup SETUP_ARGS=--install-toolkit 使用），
# 可换成镜像站提供的 libnvidia-container 镜像地址
# NVIDIA_TOOLKIT_REPO=https://nvidia.github.io/libnvidia-container

# ---- 可选 ----
# 本地开发时 PostgreSQL 暴露到本机的端口（docker-compose.dev.yml / make dev-db）
# TM_DEV_DB_PORT=5432
# 写入镜像的版本信息，留空使用源码默认值；make up / make docker-build 会自动填写提交号与提交时间
# （代码没有变化时构建参数不变，make up 不会重建 app 镜像、重启 app）
# TM_VERSION=
# TM_COMMIT=
# TM_BUILD_TIME=
