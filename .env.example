# trainMaster 部署配置。复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env。所有变量都有默认值，可以只写需要修改的项。

# ---- 访问 ----
# 宿主机上对外提供服务的 HTTP 端口，浏览器访问 http://<服务器IP>:<端口>
TM_HTTP_PORT=8080

# ---- 数据持久化（宿主机目录，绑定挂载）----
# 默认放在仓库目录下的 ./data，方便试用。正式部署建议改为仓库之外的绝对路径
# （如 /srv/trainmaster/storage、/srv/trainmaster/postgres）：在仓库里执行
# `git clean -x` 等清理命令会把 ./data 一起删除。
# 图片、数据集、模型权重、训练产物等文件数据目录，挂载为容器内 /data
TM_HOST_STORAGE_DIR=./data/storage
# PostgreSQL 数据目录（Windows 上不要放在 NTFS 盘符路径，见 docs/deployment.md）
TM_HOST_POSTGRES_DIR=./data/postgres

# ---- 数据库 ----
# 首次启动时用这些值初始化 PostgreSQL。初始化之后再修改密码，
# 需要先在数据库里执行 ALTER USER 修改，再同步修改这里。
TM_DB_USER=trainmaster
# 生产环境务必修改为强密码
TM_DB_PASSWORD=trainmaster
TM_DB_NAME=trainmaster

# ---- 运行用户 ----
# 应用以该 UID/GID 运行并写入存储目录。设为宿主机上存储目录属主的 UID/GID
# （执行 `id` 查看），这样在宿主机上可以直接读写图片文件。
PUID=1000
PGID=1000

# 时区（日志时间等）
TZ=Asia/Shanghai

# 日志级别：debug / info / warn / error
TM_LOG_LEVEL=info

# 前面有反向代理（nginx 等）时，填写代理的 IP 或网段（逗号分隔），访问日志才会采用
# 它转发的 X-Forwarded-For 作为客户端 IP；留空则不信任该请求头。见 docs/deployment.md。
TM_TRUSTED_PROXIES=

# ---- 镜像构建 ----
# 构建出的应用镜像标签：trainmaster:<TM_IMAGE_TAG>
TM_IMAGE_TAG=latest
# npm 源，国内可用 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
# Go 模块代理，国内可用 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct
# Alpine 软件源（运行镜像安装 tzdata 等），留空使用官方源，国内可用 https://mirrors.aliyun.com/alpine
ALPINE_MIRROR=
# 基础镜像，默认从 Docker Hub 拉取（node:22-alpine、golang:1.24-alpine、alpine:3.23、
# postgres:17-alpine）。无法访问 Docker Hub 时换成内网镜像仓库中的同名镜像：
# NODE_IMAGE=registry.example.com/library/node:22-alpine
# GO_IMAGE=registry.example.com/library/golang:1.24-alpine
# RUNTIME_IMAGE=registry.example.com/library/alpine:3.23
# POSTGRES_IMAGE=registry.example.com/library/postgres:17-alpine

# ---- 可选 ----
# 本地开发时 PostgreSQL 暴露到本机的端口（docker-compose.dev.yml / make dev-db）
# TM_DEV_DB_PORT=5432
# 写入镜像的版本信息，留空使用源码默认值；make up / make docker-build 会自动填写提交号与时间
# TM_VERSION=
# TM_COMMIT=
# TM_BUILD_TIME=
